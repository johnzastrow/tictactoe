# Checkboxes, radio buttons, toggle (generated by gen_tapes.py from steps.py; do not edit)
Output "tui-08-choice.gif"
Output "raw/tui-08-choice.mp4"
Set Shell zsh
Set FontSize 26
Set Width 1640
Set Height 960
Set Padding 16
Set Theme "Builtin Dark"
Set TypingSpeed 120ms
Set Framerate 24

Hide
Type '"$DEMO_BIN" tui --server "$DEMO_SERVER" --name alice'
Enter
Sleep 3000ms
Down 7
Sleep 600ms
Show
Sleep 800ms
Enter
Sleep 150ms
Sleep 300ms
# open
Tab
Sleep 150ms
Right
Sleep 150ms
Space
Sleep 150ms
Sleep 300ms
Tab
Sleep 150ms
