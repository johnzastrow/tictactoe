# Tour of the 16 tabs, walking the sidebar with Down (generated by gen_tapes.py)
Output "tui-tour.gif"
Set Shell zsh
Set FontSize 26
Set Width 1640
Set Height 960
Set Padding 16
Set Theme "Builtin Dark"
Set TypingSpeed 120ms
Set Framerate 24

Hide
Type '"$DEMO_BIN" tui --server "$DEMO_SERVER" --name alice'
Enter
Sleep 3000ms
Show
Sleep 800ms
Sleep 1400ms
Screenshot "raw/tour-01-text.png"
Sleep 600ms
Down
Sleep 300ms
Sleep 1400ms
Screenshot "raw/tour-02-number.png"
Sleep 600ms
Down
Sleep 300ms
Sleep 1400ms
