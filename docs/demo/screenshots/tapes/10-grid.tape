# Editable data grid (generated by gen_tapes.py from steps.py; do not edit)
Output "tui-10-grid.gif"
Output "raw/tui-10-grid.mp4"
Set Shell zsh
Set FontSize 26
Set Width 1640
Set Height 960
Set Padding 16
Set Theme "Builtin Dark"
Set TypingSpeed 120ms
Set Framerate 24

Hide
Type '"$DEMO_BIN" tui --server "$DEMO_SERVER" --name alice'
Enter
Sleep 3000ms
Down 9
Sleep 600ms
Show
Sleep 800ms
Enter
Sleep 150ms
Sleep 300ms
Down 2
Sleep 150ms
Right 4
Sleep 150ms
Sleep 300ms
# open
Enter
Sleep 150ms
Sleep 300ms
Down
Sleep 150ms
Sleep 1500ms
Screenshot "raw/tui-10-grid.png"
Sleep 1500ms
Escape
Escape
Escape
Sleep 150ms
Sleep 500ms
