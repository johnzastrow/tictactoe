# Gantt chart (generated by gen_tapes.py from steps.py; do not edit)
Output "tui-17-gantt.gif"
Output "raw/tui-17-gantt.mp4"
Set Shell zsh
Set FontSize 26
Set Width 1640
Set Height 960
Set Padding 16
Set Theme "Builtin Dark"
Set TypingSpeed 120ms
Set Framerate 24

Hide
Type '"$DEMO_BIN" tui --server "$DEMO_SERVER" --name alice'
Enter
Sleep 3000ms
Down 15
Sleep 600ms
Show
Sleep 800ms
Enter
Sleep 150ms
Sleep 300ms
Down
Sleep 150ms
Sleep 300ms
# open
Type ">>>"
Sleep 300ms
Type "]]"
Sleep 1500ms
Screenshot "raw/tui-17-gantt.png"
Sleep 1500ms
Escape
Sleep 300ms
Ctrl+R
Sleep 500ms
Type "y"
Sleep 800ms
Sleep 500ms
