# Text input with live validation (generated by gen_tapes.py from steps.py; do not edit)
Output "tui-01-text.gif"
Output "raw/tui-01-text.mp4"
Set Shell zsh
Set FontSize 26
Set Width 1640
Set Height 960
Set Padding 16
Set Theme "Builtin Dark"
Set TypingSpeed 120ms
Set Framerate 24

Hide
Type '"$DEMO_BIN" tui --server "$DEMO_SERVER" --name alice'
Enter
Sleep 3000ms
Show
Sleep 800ms
# open
Enter
Sleep 150ms
Sleep 300ms
Tab 2
Sleep 150ms
Sleep 300ms
Ctrl+U
Sleep 150ms
Type "ab-12"
Sleep 1500ms
Screenshot "raw/tui-01-text.png"
Sleep 1500ms
Escape
Escape
Sleep 150ms
Sleep 500ms
