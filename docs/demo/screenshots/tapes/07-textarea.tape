# Multi-line text area (generated by gen_tapes.py from steps.py; do not edit)
Output "tui-07-textarea.gif"
Output "raw/tui-07-textarea.mp4"
Set Shell zsh
Set FontSize 26
Set Width 1640
Set Height 960
Set Padding 16
Set Theme "Builtin Dark"
Set TypingSpeed 120ms
Set Framerate 24

Hide
Type '"$DEMO_BIN" tui --server "$DEMO_SERVER" --name alice'
Enter
Sleep 3000ms
Down 6
Sleep 600ms
Show
Sleep 800ms
Enter
Sleep 150ms
Sleep 300ms
# open
Type "Typed live, saved with Ctrl+S."
Enter
Sleep 150ms
Sleep 1500ms
Screenshot "raw/tui-07-textarea.png"
Sleep 1500ms
Escape
Sleep 150ms
Sleep 400ms
Type "y"
Escape
Sleep 150ms
Sleep 500ms
