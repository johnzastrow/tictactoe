# Searchable help (generated by gen_tapes.py from steps.py; do not edit)
Output "tui-18-help.gif"
Output "raw/tui-18-help.mp4"
Set Shell zsh
Set FontSize 26
Set Width 1640
Set Height 960
Set Padding 16
Set Theme "Builtin Dark"
Set TypingSpeed 120ms
Set Framerate 24

Hide
Type '"$DEMO_BIN" tui --server "$DEMO_SERVER" --name alice'
Enter
Sleep 3000ms
Down 2
Sleep 600ms
Show
Sleep 800ms
# open
Ctrl+G
Sleep 150ms
Sleep 600ms
Type "save"
Sleep 1500ms
Screenshot "raw/tui-18-help.png"
Sleep 1500ms
Escape
Sleep 150ms
Sleep 500ms
