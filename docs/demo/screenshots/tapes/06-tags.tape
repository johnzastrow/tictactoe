# Tag chips with suggestions (generated by gen_tapes.py from steps.py; do not edit)
Output "tui-06-tags.gif"
Output "raw/tui-06-tags.mp4"
Set Shell zsh
Set FontSize 26
Set Width 1640
Set Height 960
Set Padding 16
Set Theme "Builtin Dark"
Set TypingSpeed 120ms
Set Framerate 24

Hide
Type '"$DEMO_BIN" tui --server "$DEMO_SERVER" --name alice'
Enter
Sleep 3000ms
Down 5
Sleep 600ms
Show
Sleep 800ms
Enter
Sleep 150ms
Sleep 300ms
# open
Type "se"
Sleep 1500ms
Screenshot "raw/tui-06-tags.png"
Sleep 1500ms
Escape
Escape
Sleep 150ms
Sleep 500ms
