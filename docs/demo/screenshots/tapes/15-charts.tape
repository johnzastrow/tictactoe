# Bar chart, sparkline, gauge, heat strip (generated by gen_tapes.py from steps.py; do not edit)
Output "tui-15-charts.gif"
Output "raw/tui-15-charts.mp4"
Set Shell zsh
Set FontSize 26
Set Width 1640
Set Height 960
Set Padding 16
Set Theme "Builtin Dark"
Set TypingSpeed 120ms
Set Framerate 24

Hide
Type '"$DEMO_BIN" tui --server "$DEMO_SERVER" --name alice'
Enter
Sleep 3000ms
Down 13
Sleep 600ms
Show
Sleep 800ms
Enter
Sleep 150ms
Sleep 300ms
# open
Right 3
Sleep 150ms
Sleep 300ms
Up 4
Sleep 150ms
Sleep 1500ms
Screenshot "raw/tui-15-charts.png"
Sleep 1500ms
Escape
Sleep 300ms
Ctrl+R
Sleep 500ms
Type "y"
Sleep 800ms
Sleep 500ms
